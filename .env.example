SECRET_KEY=replace-this-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Supabase: use the project's PostgreSQL connection string (DATABASE_URL).
# Prefer the Supabase Session Pooler URL for hosted deployments.
DATABASE_URL=
# Set a long random value temporarily to allow the first Admin account to register.
ADMIN_SIGNUP_KEY=

# Email password reset (Gmail requires an App Password, not your normal password).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
